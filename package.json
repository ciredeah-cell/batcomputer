{
  "name": "laguna-deck",
  "productName": "Laguna Deck",
  "version": "0.1.0",
  "description": "A local-model control deck for Windows: agentic chat over llama.cpp with offload planning for unified-memory boxes, plus Claude Code and GitHub Copilot CLI as drop-in drivers.",
  "main": "electron/main.js",
  "license": "MIT",
  "author": "ciredeah",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "selftest": "node electron/selftest.js",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir",
    "smoke": "node -e \"process.env.LAGUNA_SMOKE='1';const r=require('child_process').spawnSync(require('electron'),['.'],{stdio:'inherit',env:process.env});process.exit(r.status||0)\""
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "dev.ciredeah.lagunadeck",
    "productName": "Laguna Deck",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
