{
  "name": "batcomputer",
  "productName": "Batcomputer",
  "version": "0.1.0",
  "description": "A local-AI console for Windows: agentic chat over llama.cpp with offload planning for unified-memory boxes, plus Claude Code, GitHub Copilot and ComfyUI as drop-in drivers.",
  "main": "electron/main.js",
  "license": "MIT",
  "author": "Batcomputer",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "selftest": "node electron/selftest.js",
    "dist": "electron-builder --win --publish never",
    "dist:dir": "electron-builder --win --dir --publish never",
    "smoke": "node -e \"process.env.BAT_SMOKE='1';const r=require('child_process').spawnSync(require('electron'),['.'],{stdio:'inherit',env:process.env});process.exit(r.status||0)\""
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "io.github.batcomputer.app",
    "productName": "Batcomputer",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json",
      "build/icon.*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "icon": "build/icon.png"
  }
}
